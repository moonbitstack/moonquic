// A QUIC connection, RFC 9000 §7, §12.3 and §18:
// https://www.rfc-editor.org/rfc/rfc9000#section-7
//
// The transport parameters an endpoint declares (§18), the three packet-number spaces
// and the CRYPTO stream per encryption level (§12.3, RFC 9001 §4.1.3), a server
// connection driving the TLS handshake, and the connection table and event loop a
// server runs over them (§5.2, §8.1, §10, §14.1).
//
// It holds no socket and no clock: the peer's address is a type parameter, every entry
// point takes `now`, and the signing key arrives as a `@spec.Signer` the caller keeps.
import {
  "moonbitstack/moonvar/quic",
  "moonbitstack/moonquic/frame",
  "moonbitstack/moonquic/packet",
  "moonbitstack/moonquic/crypto",
  "moonbitstack/moonquic/recovery",
  "moonbitstack/moonquic/stream",
  "moonbitstack/moontls/keys",
  "moonbitstack/moontls/msg",
  "moonbitstack/moontls/ext",
  "moonbitstack/moontls/hs",
  "moonbitstack/moontls/alert",
  "moonbitstack/mooncrypt/spec",
}
